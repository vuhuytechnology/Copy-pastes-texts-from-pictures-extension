{
  "manifest_version": 3,
  "name": "Image Text Selector — Select & Copy Text from Images",
  "version": "1.2.0",
  "minimum_chrome_version": "109",
  "description": "Turn text inside any web image into selectable, copyable text (Ctrl+C / Ctrl+V) with offline OCR and region capture (Alt+Shift+O).",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "ocr-region": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Select a screen region to extract text (OCR)"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
